# ============================================================
# 星枢平台本地运行配置
# 生成位置：%USERPROFILE%\XingShuEnv\config\app.env.ps1
# 说明：这里填的 Key 只会写入你本机的数据库/环境变量，不会被提交到任何仓库。
# ============================================================

# 运行目录（默认即可）
$env:XINGSHU_RUNTIME = Join-Path $env:USERPROFILE 'XingShuEnv'

# MySQL 端口（默认 3306，root 密码固定为 1234）
$env:XINGSHU_MYSQL_PORT = '3306'

# ---------- 大模型（智能体问答 / 作业生成 / 学情分析） ----------
# 阿里云百炼 DashScope（OpenAI 兼容），推荐 qwen-plus
$env:XINGSHU_LLM_API_KEY = ''
$env:XINGSHU_LLM_BASE_URL = 'https://dashscope.aliyuncs.com/compatible-mode/v1'
$env:XINGSHU_LLM_MODEL = 'qwen-plus'

# ---------- 向量模型（RAG 检索，教材/课件问答） ----------
# 硅基流动 SiliconFlow，推荐 BAAI/bge-m3（1024 维，与种子数据一致）
$env:XINGSHU_EMBEDDING_API_KEY = ''
$env:XINGSHU_EMBEDDING_BASE_URL = 'https://api.siliconflow.cn'
$env:XINGSHU_EMBEDDING_MODEL = 'BAAI/bge-m3'

# 留空时也能启动平台，但智能体问答会提示模型凭据缺失；
# 可在管理员端「模型配置」页面填入并发布，效果等价。
